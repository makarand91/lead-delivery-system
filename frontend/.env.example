# API Configuration
VITE_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/v1

# AWS Cognito Configuration
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Note: Identity Pool is NOT needed for this application
# The frontend only uses Cognito for authentication (JWT tokens)
# All AWS service access (S3, DynamoDB, etc.) happens through the backend API

