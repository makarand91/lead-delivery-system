# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# Existing Infrastructure (DO NOT CREATE)
EXISTING_VPC_ID=vpc-xxxxxxxxxxxxx
EXISTING_FARGATE_CLUSTER_NAME=my-fargate-cluster

# Application Configuration
APP_NAME=lead-delivery-system
ENVIRONMENT=dev

# Cognito Configuration
COGNITO_DOMAIN_PREFIX=lead-delivery-dev

# API Configuration
API_THROTTLE_RATE_LIMIT=1000
API_THROTTLE_BURST_LIMIT=2000

# Batch Processing
BATCH_SCHEDULE=cron(0 * * * ? *)  # Every hour
BATCH_CONCURRENT_DELIVERIES=10

# Lambda Configuration
LAMBDA_MEMORY_SIZE=1024
LAMBDA_TIMEOUT=300

# ElasticSearch Configuration
ELASTICSEARCH_INSTANCE_TYPE=t3.small.search
ELASTICSEARCH_VOLUME_SIZE=10
